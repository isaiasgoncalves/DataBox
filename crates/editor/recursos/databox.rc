// Recursos do DataBox.exe: ícone, versão e manifesto. Compilado pelo build.rs com o windres do MinGW.
// O databox.ico sai de design\ferramentas\ico.py, com os PNG do logo de crates\interface\assets\logo.
#pragma code_page(65001)

1 ICON "databox.ico"
1 24 "databox.manifest"

1 VERSIONINFO
FILEVERSION 0,2,1,0
PRODUCTVERSION 0,2,1,0
FILEFLAGSMASK 0x3F
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041604B0"
    BEGIN
      VALUE "CompanyName", "Isaías Gonçalves"
      VALUE "FileDescription", "DataBox"
      VALUE "FileVersion", "0.2.1"
      VALUE "InternalName", "DataBox"
      VALUE "LegalCopyright", "© 2026 Isaías Gonçalves — licença MIT"
      VALUE "OriginalFilename", "DataBox.exe"
      VALUE "ProductName", "DataBox"
      VALUE "ProductVersion", "0.2.1"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0416, 1200
  END
END
